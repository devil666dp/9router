# 9Router environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/var/lib/9router

# Recommended runtime variables
PORT=20128
NODE_ENV=production

# ── Database engine ───────────────────────────────────────────────────────────
# Default (everything below unset): the embedded SQLite store under DATA_DIR.
#
# DB_DRIVER selects the engine explicitly. With DB_DRIVER=postgres the URL may
# come from any of DATABASE_URL, POSTGRES_URL, NEON_DB_URL, SUPABASE_DB_URL,
# PG_URL or PGURL, and starting with none of them set is an error rather than a
# silent fall back to SQLite. DB_DRIVER=sqlite forces SQLite even when a
# Postgres URL is exported — the escape hatch for "ignore the URL in my .env".
# DB_DRIVER=postgres
# DB_DRIVER=sqlite
#
# With DB_DRIVER unset, only these two generic names switch the store on their
# own (DATABASE_URL wins if both are set). Vendor-specific names do NOT: one can
# sit in .env as a credential for scripts and tests without moving live data.
# Whichever engine is chosen is the only store — state is never split across two.
# DATABASE_URL=postgres://user:password@host:5432/9router?sslmode=require
# POSTGRES_URL=
# Optional pool tuning (defaults shown).
# PG_POOL_MAX=10
# PG_IDLE_TIMEOUT_MS=30000
# PG_CONNECT_TIMEOUT_MS=15000

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:20128
CLOUD_URL=https://9router.com
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=9router
